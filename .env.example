# ==============================================================================
# Turno B Grupo 4: Agentic Incidents-PIMS for UNSA - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
#
# IMPORTANT:
#   - NEVER commit real secrets or credentials into the repository.
#   - Production write actions REQUIRE explicit user/instructor confirmation.
#   - All placeholders marked 'CHANGEME' must be replaced with authorized values.
# ==============================================================================

# ------------------------------------------------------------------------------
# PIMS (GESTITEL) Configuration (docs/SPEC.md §3, §3.1)
# ------------------------------------------------------------------------------
# Primary source-of-truth PIMS instance
PIMS_BASE_URL=https://unsa.27k.pe
# Group 4 tenant credentials (JWT auth via POST /business/login/)
PIMS_USERNAME=CHANGEME
PIMS_PASSWORD=CHANGEME
# Multi-tenant schema identifier
PIMS_TENANT_SCHEMA=unsa
# Mandatory prefix for group 4 documents and incidents to avoid cross-group contamination
PIMS_CODE_PREFIX=G4-

# ------------------------------------------------------------------------------
# Database / pgvector Sidecar Configuration (docs/SPEC.md §3, §4)
# ------------------------------------------------------------------------------
POSTGRES_DB=pims_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://agent:CHANGEME@db:5432/pims_agent

# ------------------------------------------------------------------------------
# Embedding Model & Vector Search (docs/SPEC.md §3)
# ------------------------------------------------------------------------------
# OpenAI-compatible embeddings endpoint (1024-dimension vectors)
EMBEDDINGS_API_KEY=CHANGEME
EMBEDDINGS_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_MODEL=mistral-embed

# ------------------------------------------------------------------------------
# LLM Providers & omp Agent Configuration (docs/SPEC.md §5)
# ------------------------------------------------------------------------------
# Name of the environment variable omp expects for your chosen provider
# (e.g., OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENCODE_API_KEY)
AGENT_ENV_VAR=OPENAI_API_KEY
AGENT_API_KEY=CHANGEME

# Default omp model (<provider>/<model-id>, passed via --model)
AGENT_MODEL=opencode-go/muse-spark-1.3-contributor

# ------------------------------------------------------------------------------
# VPS Infrastructure & Docker API (docs/SPEC.md §4, §4.1)
# ------------------------------------------------------------------------------
# Docker host connection (defaults to docker-proxy on internal-proxy network)
DOCKER_HOST=tcp://docker-proxy:2375

# Domain root for spawned deliverables and reserved slugs
DOMAIN_ROOT=pimsai.mistercricro8.top

# Fallback diagnostic port for Cloudflare 443->444 rule (SPEC §4.1, §13)
FALLBACK_PORT=444

# ------------------------------------------------------------------------------
# Unified Web App (Auth & Runtime Customization)
# ------------------------------------------------------------------------------
WEB_PUBLIC_URL=https://demo.pimsai.mistercricro8.top:444
# Required read-write token for full operator access
WEB_RW_TOKEN=CHANGEME
# Optional read-only token for passive observer access
WEB_RO_TOKEN=CHANGEME_OPTIONAL
# Optional runtime branding overrides (defaults come from apps/web/branding.json)
# WEB_APP_NAME=UNSA PIMS — Operador Agéntico del SGPI
# WEB_APP_SUBTITLE=ISO/IEC 27701:2025 · Turno B Grupo 4
# WEB_PRIMARY_COLOR=#64001D
# WEB_ACCENT_COLOR=#D4AF37
# WEB_DEFAULT_THEME=dark

# ------------------------------------------------------------------------------
# Age Secrets Store (built into unified web app)
# ------------------------------------------------------------------------------
# Directory inside container where age-encrypted secrets are stored
SECRETS_STORE_PATH=/app/secrets
# Age secret key for decrypting credentials inside spawned sibling containers
AGE_SECRET_KEY=CHANGEME

# ------------------------------------------------------------------------------
# Outbound Mail / Gmail SMTP & Corpus Mirror
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_FROM=
CORPUS_MIRROR_DIR=/var/lib/pimsai/corpus_mirror
