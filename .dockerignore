# ==============================================================================
# Docker Ignore Configuration
# ==============================================================================

# Version control
.git/
.gitignore

# Environment configurations and secrets
.env
.env.*
.enc.env
*.enc.env
.sops.yaml
!.env.example
*.age
*.key
key.txt
/secrets/

# Large ISO documents and PDFs (keep build context light and fast)
docs/*.pdf
*.pdf
*.svg
*.png

# Node / Bun dependencies and caches
node_modules/
apps/web/client/node_modules/
apps/web/client/dist/
.bun/
dist/
!apps/web/client/public/**

# Corpus mirror storage
corpus_mirror/

# omp sessions and runtime caches
.omp/sessions/
.omp/cache/

# IDE and OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
