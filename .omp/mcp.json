{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--browser",
        "chrome",
        "--executable-path",
        "/usr/bin/chromium",
        "--no-sandbox",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    }
  }
}
